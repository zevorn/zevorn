#!/bin/bash
# RISC-V Server Platform configure script
# Simplified version for riscv64-softmmu target

set -e

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Default values
target_list="riscv64-softmmu"
prefix="/usr/local"
build_dir="build"
enable_debug="no"
enable_kvm="no"

# Parse command line arguments
while [ "$#" -gt 0 ]; do
    case "$1" in
        --target-list=*)
            target_list="${1#*=}"
            ;;
        --prefix=*)
            prefix="${1#*=}"
            ;;
        --enable-debug)
            enable_debug="yes"
            ;;
        --enable-kvm)
            enable_kvm="yes"
            ;;
        --help|-h)
            echo "RISC-V Server Platform Configuration Script"
            echo ""
            echo "Usage: $0 [options]"
            echo ""
            echo "Options:"
            echo "  --target-list=LIST    Target architectures (default: riscv64-softmmu)"
            echo "  --prefix=PREFIX       Installation prefix (default: /usr/local)"
            echo "  --enable-debug        Enable debug build"
            echo "  --enable-kvm          Enable KVM support"
            echo "  --help, -h            Show this help message"
            echo ""
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            echo "Run '$0 --help' for usage information"
            exit 1
            ;;
    esac
    shift
done

echo -e "${GREEN}==================================="
echo "RISC-V Server Platform Configuration"
echo -e "===================================${NC}"
echo ""
echo "Target list:      $target_list"
echo "Install prefix:   $prefix"
echo "Debug build:      $enable_debug"
echo "KVM support:      $enable_kvm"
echo ""

# Create build directory
echo -e "${YELLOW}Creating build directory...${NC}"
mkdir -p "$build_dir"

# Generate config.status
cat > "$build_dir/config.status" << EOF
# Generated by configure
# Configuration for RISC-V Server Platform

TARGET_LIST=$target_list
PREFIX=$prefix
ENABLE_DEBUG=$enable_debug
ENABLE_KVM=$enable_kvm
BUILD_DIR=$build_dir
EOF

# Generate simple Makefile for build directory
cat > "$build_dir/Makefile" << 'EOF'
# Auto-generated Makefile for riscv64-softmmu

include ../config.mk

.PHONY: all clean

all:
	@echo "Building riscv64-softmmu target..."
	@echo "Build system ready. Source files should be compiled here."
	@echo ""
	@echo "Note: This is a template build system."
	@echo "Add actual compilation rules as needed."

clean:
	@echo "Cleaning build artifacts..."
	@rm -f *.o *.a

install:
	@echo "Installing to $(PREFIX)..."
	@mkdir -p $(PREFIX)/bin
	@echo "Installation complete."
EOF

echo -e "${GREEN}Configuration completed successfully!${NC}"
echo ""
echo "Build directory: $build_dir"
echo "Configuration saved to: $build_dir/config.status"
echo ""
echo -e "${YELLOW}Next steps:${NC}"
echo "  cd $build_dir"
echo "  make"
echo ""
